[Unit]
Description=Job Applications Daily Tracker Run
After=network.target nfs-client.target
RequiresMountsFor=/mnt/job-app-data

[Service]
WorkingDirectory=%h/Projects/Job-Applications
ExecStart=%h/Projects/Job-Applications/venv/bin/python \
          tracker_daily.py
EnvironmentFile=%h/Projects/Job-Applications/.env
