[Unit]
Description=Job Applications Daily Job Digest Run
After=network-online.target nfs-client.target
Wants=network-online.target
RequiresMountsFor=/mnt/job-app-data

[Service]
Type=oneshot
TimeoutStartSec=600
WorkingDirectory=%h/Projects/Job-Applications
ExecStart=%h/Projects/Job-Applications/.venv/bin/python \
          job_digest.py
EnvironmentFile=-%h/.config/job-applications/env
