[Unit]
Description=Job Applications AI-Assistant Orchestration Consumer
After=network-online.target nfs-client.target
Wants=network-online.target
RequiresMountsFor=/mnt/job-app-data

[Service]
Type=simple
WorkingDirectory=%h/Projects/Job-Applications
ExecStart=%h/Projects/Job-Applications/venv/bin/python \
          orchestration_consumer.py
Environment=JOB_APP_STORAGE_BACKEND=postgres
Environment=JOB_APP_BASE_DIR=/mnt/job-app-data
EnvironmentFile=%h/Projects/Job-Applications/.env
Restart=on-failure
RestartSec=10
# Exit 2 = invalid configuration (e.g. JOB_APP_KAFKA_BROKER unset): stop, do not loop.
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
