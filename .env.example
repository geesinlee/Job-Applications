# Job-Applications MCP server — environment configuration template.
# Copy to .env and fill in real values. Never commit the real .env file
# (it is gitignored). No real values belong in this template.

# ─── Data paths ────────────────────────────────────────────────────────────
# Local development defaults to the ignored ./data directory. Production may
# use any persistent volume or network mount owned by the deployer.

# Base directory for persistent artefacts. Structured state is stored in Postgres.
# In Postgres mode this is not used for tracker/profile state.
# Example persistent volume: JOB_APP_BASE_DIR=/srv/job-applications/data
JOB_APP_BASE_DIR=/path/to/job-applications/data

# Directory where per-company artefact folders (JD.md, CVs, research, etc.)
# live. Default: same as JOB_APP_BASE_DIR.
# It may be the same directory as JOB_APP_BASE_DIR.
JOB_APP_ARTEFACTS_DIR=/path/to/job-applications/data

# Legacy migration/backup path only. Production MCP does not read or write this file.
JOB_APP_TRACKER_PATH=/path/to/job-applications/data/tracker.json

# Legacy migration/backup path only. Production MCP does not read or write this file.
JOB_APP_PROFILE_PATH=/path/to/job-applications/data/profile.json

# Path to the reference CV (single source of truth) used by job_digest.py for
# keyword pre-filtering. Default: JOB_APP_ARTEFACTS_DIR/base_cv/Reference_CV.md
JOB_APP_REFERENCE_CV_PATH=/path/to/job-applications/data/base_cv/Reference_CV.md

# Path to the tenant-owned base/master CV used as the tailoring source.
JOB_APP_BASE_CV_PATH=/path/to/job-applications/data/base_cv/Reference_CV.md

# ─── Optional remote backup (legacy) ───────────────────────────────────────
# Legacy JSON backup destination. Leave empty for Postgres-canonical deployments.
# Default: "" (disabled; backup sync is skipped silently when unset).
# When using shared storage directly, leave this empty.
NAS_SYNC_PATH=

# Comma-separated discovery preferences. These are intentionally neutral;
# set them for the deployment's candidate and target market.
JOB_DIGEST_LOCATION_KEYWORDS=remote,hybrid
JOB_DIGEST_INDUSTRY_KEYWORDS=software,technology,cloud,consulting
JOB_DIGEST_ACCOUNT_KEYWORDS=

# Exact target-account aliases for known AI-core and AI-adjacent companies.
# Setting this replaces the built-in list. Companies not listed can still pass
# when the job card explicitly describes an AI or adjacent data-platform product.
JOB_DIGEST_AI_TARGET_COMPANIES=openai,anthropic,palantir,mistral ai,databricks,snowflake,confluent

# Optional terms used by the evidence contradiction detector. Leave empty to
# disable geography-scope inference, or provide deployment-relevant regions.
JOB_APP_GEOGRAPHY_TERMS=

# ─── MCP server transport ─────────────────────────────────────────────────
# Transport mode: "stdio" (default, local client session) or "http" (always-on
# service).
MCP_MODE=stdio

# URL used by the checked-in .mcp.json client template.
JOB_APP_MCP_URL=http://localhost:8086/mcp

# Bearer token required to authenticate HTTP MCP requests when MCP_MODE=http.
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=<GENERATE_WITH: python3 -c "import secrets;print(secrets.token_urlsafe(32))">

# Structured state backend. Production deployments should use Postgres.
JOB_APP_STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://job_app:<PASSWORD>@<POSTGRES_HOST>:5432/job_applications

# ─── AI-Assistant orchestration pilot ──────────────────────────────
# The worker is disabled by default. When enabled it remains dry-run unless
# execute is separately opted in. Stage changes require both the stage flag
# and an explicit action.new_stage in the event; update_stage still validates
# the transition through the Job-Applications stage machine.
JOB_APP_ORCHESTRATION_ENABLED=false
JOB_APP_ORCHESTRATION_EXECUTE=false
JOB_APP_ORCHESTRATION_UPDATE_STAGE=false
JOB_APP_ORCHESTRATION_TOPIC=orchestration.action_proposed
JOB_APP_ORCHESTRATION_GROUP=job-applications-orchestration-v1
JOB_APP_ORCHESTRATION_RESULT_EVENTS_ENABLED=true
JOB_APP_ORCHESTRATION_RESULT_TOPIC=orchestration.action_completed
JOB_APP_KAFKA_BROKER=localhost:9092

# ─── Health probe (app_health.py) ─────────────────────────────────────────
JOB_APP_HEALTH_STATE_PATH=
JOB_APP_HEALTH_ALERT_STATE_PATH=
JOB_APP_HEALTH_DIGEST_MAX_AGE_DAYS=2
JOB_APP_HEALTH_HTTP_TIMEOUT_SECONDS=8
JOB_APP_HEALTH_SOCKET_TIMEOUT_SECONDS=5
JOB_APP_HEALTH_WEBHOOK_URL=
JOB_APP_HEALTH_KAFKA_ENABLED=false
JOB_APP_HEALTH_KAFKA_TOPIC=job_applications.health

# ─── SMTP (shared via fleet-notify) ─────────────────────────────────────────
# fleet-notify auto-loads these via load_smtp_config().
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=<SMTP_APP_PASSWORD>
SMTP_TO=user@example.com
SMTP_FROM=user@example.com

# ─── Job digest (job_digest.py) ────────────────────────────────────────────
# Path to email accounts config file for OAuth2 authentication.
# Each account has a "provider" field (default: "gmail"). Future providers:
#   outlook, yahoo, apple — add to VALID_PROVIDERS in gmail_auth.py when implemented.
# Default: gmail_accounts.json in the project root.
GMAIL_ACCOUNTS_CONFIG=gmail_accounts.json

# Gmail list API page size for LinkedIn job-alert discovery catch-up.
JOB_DIGEST_GMAIL_PAGE_SIZE=100

# Job discovery triage. Use "rules" for deterministic fallback, or "llm" to
# classify deduplicated LinkedIn cards against the candidate resume context.
JOB_DIGEST_TRIAGE_MODE=rules
JOB_DIGEST_TRIAGE_BATCH_SIZE=8
JOB_DIGEST_TRIAGE_MIN_SCORE=70
JOB_DIGEST_TRIAGE_CV_CONTEXT_CHARS=6000
JOB_DIGEST_LLM_MODEL=
JOB_DIGEST_LLM_MAX_TOKENS=8192
JOB_DIGEST_TRIAGE_FAIL_OPEN=false

# LLM provider for evidence extraction. "mock" requires no external account;
# set "gemini" or "anthropic" only after installing/configuring that provider.
LLM_PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
