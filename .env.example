# Job-Applications MCP server — environment configuration template.
# Copy to .env and fill in real values. Never commit the real .env file
# (it is gitignored). No real values belong in this template.

# Base directory for tracker.json/profile.json when no more specific path is
# set. Default: the directory containing job_applications_mcp_server.py.
JOB_APP_BASE_DIR=/path/to/job-applications/data

# Directory where per-company artefact folders (JD.md, CVs, research, etc.)
# live. Default: same as JOB_APP_BASE_DIR.
JOB_APP_ARTEFACTS_DIR=/path/to/job-applications/artefacts

# Path to tracker.json (application records). Default: JOB_APP_BASE_DIR/tracker.json.
JOB_APP_TRACKER_PATH=/path/to/job-applications/data/tracker.json

# Path to profile.json (candidate profile). Default: JOB_APP_BASE_DIR/profile.json.
JOB_APP_PROFILE_PATH=/path/to/job-applications/data/profile.json

# Path to the base/master CV used as the source for tailoring. Default:
# JOB_APP_ARTEFACTS_DIR/DXC/CV LEE Gee Sin 2026 - DXC Client Partner Public Sector.md
JOB_APP_BASE_CV_PATH=/path/to/job-applications/artefacts/DXC/base-cv.md

# rsync destination for backing up tracker.json/profile.json after every
# write (e.g. gs@rv-cloud.local:/share/job-app-data/). Default: "" (disabled;
# NAS sync is skipped silently when unset).
NAS_SYNC_PATH=

# Transport mode for the MCP server: "stdio" (default, local Claude session)
# or "http" (always-on service, e.g. pi-4).
MCP_MODE=stdio

# Bearer token required to authenticate HTTP MCP requests when MCP_MODE=http.
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=<GENERATE_WITH: python3 -c "import secrets;print(secrets.token_urlsafe(32))">
