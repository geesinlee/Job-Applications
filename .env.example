# Job-Applications MCP server — environment configuration template.
# Copy to .env and fill in real values. Never commit the real .env file
# (it is gitignored). No real values belong in this template.

# ─── Data paths ────────────────────────────────────────────────────────────
# Recommended: NFS-mounted NAS share for multi-host consistency.
# On pi-4: /mnt/job-app-data (NFS mount of 192.168.10.109:/share/job-app-data)
# On Mac:   /mnt/job-app-data (NFS or SMB mount of same NAS share)
#
# Local paths (single-host, no NAS):
#   JOB_APP_BASE_DIR defaults to the directory containing this script.

# Base directory for tracker.json/profile.json when no more specific path is
# set. Default: the directory containing job_applications_mcp_server.py.
# For NAS-shared storage: JOB_APP_BASE_DIR=/mnt/job-app-data
JOB_APP_BASE_DIR=/path/to/job-applications/data

# Directory where per-company artefact folders (JD.md, CVs, research, etc.)
# live. Default: same as JOB_APP_BASE_DIR.
# For NAS-shared storage: JOB_APP_ARTEFACTS_DIR=/mnt/job-app-data
JOB_APP_ARTEFACTS_DIR=/path/to/job-applications/artefacts

# Path to tracker.json (application records). Default: JOB_APP_BASE_DIR/tracker.json.
# For NAS-shared storage: JOB_APP_TRACKER_PATH=/mnt/job-app-data/tracker.json
JOB_APP_TRACKER_PATH=/path/to/job-applications/data/tracker.json

# Path to profile.json (candidate profile). Default: JOB_APP_BASE_DIR/profile.json.
# For NAS-shared storage: JOB_APP_PROFILE_PATH=/mnt/job-app-data/profile.json
JOB_APP_PROFILE_PATH=/path/to/job-applications/data/profile.json

# Path to the reference CV (single source of truth) used by job_digest.py for
# keyword pre-filtering. Default: JOB_APP_ARTEFACTS_DIR/Base CV/Reference_CV.md
JOB_APP_REFERENCE_CV_PATH=/path/to/job-applications/artefacts/Base CV/Reference_CV.md

# Path to the base/master CV used as the source for tailoring. Default:
# JOB_APP_ARTEFACTS_DIR/DXC/CV LEE Gee Sin 2026 - DXC Client Partner Public Sector.md
# For NAS-shared storage: JOB_APP_BASE_CV_PATH=/mnt/job-app-data/DXC/CV LEE Gee Sin 2026 - DXC Client Partner Public Sector.md
JOB_APP_BASE_CV_PATH=/path/to/job-applications/artefacts/DXC/base-cv.md

# ─── NAS sync (legacy, superseded by NAS-shared storage) ───────────────────
# rsync destination for backing up tracker.json/profile.json after every write.
# Default: "" (disabled; NAS sync is skipped silently when unset).
# When using NAS-shared storage (JOB_APP_BASE_DIR points to NFS mount), this
# is unnecessary — data lives on the NAS directly. Leave empty.
NAS_SYNC_PATH=

# ─── MCP server transport ─────────────────────────────────────────────────
# Transport mode: "stdio" (default, local Claude session) or "http" (always-on
# service, e.g. pi-4).
MCP_MODE=stdio

# Bearer token required to authenticate HTTP MCP requests when MCP_MODE=http.
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=<GENERATE_WITH: python3 -c "import secrets;print(secrets.token_urlsafe(32))">

# Externally reachable host:port used to build the OAuth resource metadata
# URL when MCP_MODE=http (must match how clients actually reach the server).
# Default: "localhost". e.g. gs-pi-4.local for the pi-4 deployment.
MCP_PUBLIC_HOST=localhost

# ─── SMTP (shared via fleet-notify) ─────────────────────────────────────────
# fleet-notify auto-loads these via load_smtp_config().
# NOTE: SMTP sends from the OFFICIAL work account (geesin.lee@gmail.com).
#       The Gmail API reader account (geesin@gmail.com) is configured separately
#       in gmail_accounts.json — do NOT use it for SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=geesin.lee@gmail.com
SMTP_PASS=          # Gmail App Password (16-char) for geesin.lee@gmail.com
SMTP_TO=geesin.lee@gmail.com
SMTP_FROM=geesin.lee@gmail.com

# ─── External MCP server paths (Mac Claude Code sessions) ──────────────────
# Used by .mcp.json (${VAR} substitution) when running this project's Claude
# Code session on the Mac. Mac-local absolute paths — adjust if your checkout
# locations differ.
AI_ASSISTANT_MCP_SERVER_PATH=/path/to/AI-Assistant/src/ai_assistant/mcp_server.py
CONTACTS_MCP_SERVER_PATH=/path/to/Contact-Cleanup/contacts_mcp_server.py
CONTACTS_CACHE_PATH=/path/to/Contact-Cleanup/contacts_cache.json
SGDI_MCP_SERVER_PATH=/path/to/Contact-Cleanup/sgdi_mcp_server.py
SGDI_CACHE_PATH=/path/to/Contact-Cleanup/sgdi_cache.json
GEBIZ_AWARDS_MCP_SERVER_PATH=/path/to/GeBiz-Awards/mcp_server.py

# ─── Job digest (job_digest.py) ────────────────────────────────────────────
# Path to email accounts config file for OAuth2 authentication.
# Each account has a "provider" field (default: "gmail"). Future providers:
#   outlook, yahoo, apple — add to VALID_PROVIDERS in gmail_auth.py when implemented.
# Default: gmail_accounts.json in the project root.
GMAIL_ACCOUNTS_CONFIG=gmail_accounts.json