{
  "mcpServers": {
    "job-applications": {
      "type": "http",
      "url": "http://gs-pi-4.local:8086/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_AUTH_TOKEN}"
      }
    },
    "ai-assistant": {
      "command": "python3",
      "args": ["${AI_ASSISTANT_MCP_SERVER_PATH}"]
    },
    "contacts": {
      "command": "python3",
      "args": ["${CONTACTS_MCP_SERVER_PATH}"],
      "env": {
        "CONTACTS_CACHE_PATH": "${CONTACTS_CACHE_PATH}"
      }
    },
    "sgdi": {
      "command": "python3",
      "args": ["${SGDI_MCP_SERVER_PATH}"],
      "env": {
        "SGDI_CACHE_PATH": "${SGDI_CACHE_PATH}"
      }
    },
    "gebiz-awards": {
      "command": "python3",
      "args": ["${GEBIZ_AWARDS_MCP_SERVER_PATH}"]
    }
  }
}
